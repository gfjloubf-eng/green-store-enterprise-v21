{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend-react/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/argon2/lib/binding/**/*.node"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?path=/$1" },
    { "source": "/auth/(.*)", "destination": "/api/index.js?path=/auth/$1" },
    { "source": "/((?!api/|auth/|assets/|favicon.svg|index.html).*)", "destination": "/index.html" }
  ]
}
