# ============================================================
# Green Store — Environment Variables (نموذج الإعدادات)
# انسخ هذا الملف إلى .env واملأ القيم، أو اضبطها في Vercel:
#   Vercel → Project → Settings → Environment Variables
# ============================================================

# --- قاعدة البيانات (PostgreSQL عبر Prisma) ---
# مثال: DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"
# DATABASE_URL=

# --- التخزين (Supabase Storage لرفع صور المنتجات) ---
# من لوحة Supabase: Project Settings → API
# SUPABASE_URL — رابط المشروع مثل: https://abcd1234.supabase.co
# SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY — مفتاح service_role (سري، لا تشاركه!)
# SUPABASE_SERVICE_ROLE_KEY=

# اسم حاوية الصور (اختياري — الافتراضي product-images)
# SUPABASE_STORAGE_BUCKET=product-images

# مفتاح JWT قديم (اختياري — فقط إن كنت تستخدم مفاتيح legacy)
# SUPABASE_STORAGE_JWT_KEY=

# --- المصادقة / JWT ---
# JWT_SECRET=
# JWT_REFRESH_SECRET=
