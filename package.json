    "react-router-dom": "^7.14.0",
    "three": "^0.183.2",
    "zustand": "^5.0.12",
    "argon2": "^0.30.0"
  },

  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "prisma": "^7.9.1"
  }
